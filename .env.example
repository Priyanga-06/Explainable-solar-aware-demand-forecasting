# ─── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Frontend API URL (set in frontend/.env if running separately)
# VITE_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
